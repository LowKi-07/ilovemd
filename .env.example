# ilovemd public deployment - copy these into your host's environment
# variables panel (Render "Environment", cPanel "Setup Node.js App"). Never
# commit real values.

ILOVEMD_MODE=public
HOST=0.0.0.0

# Required. Signs each visitor's anonymous id cookie (and login cookies, if
# the password gate is on). Generate with: openssl rand -hex 32
# Changing it gives every visitor a new id, i.e. a fresh empty folder.
ILOVEMD_SESSION_SECRET=

# Optional. Leave unset for a site anyone can use; set it to require one
# shared password first.
# ILOVEMD_GATE_PASSWORD=

# Where visitors' files live (users/<id>/...). Point at a persistent disk.
# ILOVEMD_DATA_DIR=/var/data
# Visitor folders untouched this many days are deleted.
# ILOVEMD_USER_DATA_DAYS=30

# AI provider: gemini | grok | openai | anthropic. If unset, the first key
# present below wins, in that order.
ILOVEMD_AI_PROVIDER=gemini
GEMINI_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: a different model than the provider default
# (gemini-2.5-flash, grok-3-mini, gpt-4.1-mini, claude-3-5-sonnet-20241022)
# ILOVEMD_AI_MODEL=

# Limits on AI calls. Also set a budget cap on the AI key itself - these
# count per server process and reset on restart.
# Per visitor, per hour:
ILOVEMD_RATE_LIMIT_PER_HOUR=20
# Per network address, per hour (default 3x the above):
# ILOVEMD_IP_RATE_LIMIT_PER_HOUR=60
# Whole site, per day (resets midnight UTC):
ILOVEMD_MAX_CALLS_PER_DAY=200
# In flight at once; past this, visitors are asked to retry:
# ILOVEMD_MAX_CONCURRENT_AI=8
# Files uploaded for conversion, per visitor per hour:
# ILOVEMD_UPLOADS_PER_HOUR=60
# Component-kit files uploaded, per visitor per hour:
# ILOVEMD_KIT_FILES_PER_HOUR=3000

# Reverse proxies in front of the server (Render, cPanel: 1). Used to find
# the visitor's real IP. Set 0 only if the server faces the internet directly.
# ILOVEMD_TRUSTED_PROXIES=1

# Optional fixed Figma demo
# FIGMA_TOKEN=
# ILOVEMD_DEMO_FIGMA_KEY=
